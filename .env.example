# ============================================
# VoiceFlow Marketing AI - Environment Config
# Copy to .env and fill in real values
# ============================================

# ----- Application -----
APP_NAME=VoiceFlow Marketing AI
APP_ENV=development
# Options: development, staging, production
DEBUG=True
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
API_VERSION=v1

# ----- Server -----
HOST=0.0.0.0
PORT=8000
WORKERS=4

# ----- Database -----
# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/voiceflow
# Redis for caching and Celery broker
REDIS_URL=redis://localhost:6379/0

# ----- Authentication (JWT) -----
ALGORITHM=HS256
JWT_SECRET_KEY=your-jwt-secret-key-minimum-32-chars
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ----- Voice AI Models -----
WHISPER_MODEL_SIZE=base
# Options: tiny, base, small, medium, large
# tiny = fastest/least accurate, large = slowest/most accurate
TORCH_DEVICE=cpu
# Options: cpu, cuda (GPU)

# ----- LLM Providers -----
# Anthropic Claude (recommended for quality)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
# OpenAI GPT (alternative)
OPENAI_API_KEY=sk-your-openai-api-key
# Groq (fast and affordable)
GROQ_API_KEY=gsk_your-groq-api-key

# ----- CRM Integrations -----
# Zoho CRM
ZOHO_CLIENT_ID=your_zoho_client_id
ZOHO_CLIENT_SECRET=your_zoho_client_secret
ZOHO_REFRESH_TOKEN=your_zoho_refresh_token
ZOHO_ORG_ID=your_zoho_org_id

# HubSpot
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token
HUBSPOT_PORTAL_ID=your_hubspot_portal_id

# Salesforce (optional, planned)
SALESFORCE_CLIENT_ID=your_sf_client_id
SALESFORCE_CLIENT_SECRET=your_sf_client_secret
SALESFORCE_USERNAME=your_sf_username
SALESFORCE_PASSWORD=your_sf_password
SALESFORCE_SECURITY_TOKEN=your_sf_security_token

# ----- Marketing Integrations -----
# Meta (Facebook) Ads
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_ACCESS_TOKEN=your_meta_access_token
META_AD_ACCOUNT_ID=your_ad_account_id
META_PIXEL_ID=your_pixel_id

# Google Ads
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token
GOOGLE_ADS_CLIENT_ID=your_google_client_id
GOOGLE_ADS_CLIENT_SECRET=your_google_client_secret
GOOGLE_ADS_REFRESH_TOKEN=your_google_refresh_token
GOOGLE_ADS_CUSTOMER_ID=your_customer_id
GOOGLE_ADS_LOGIN_CUSTOMER_ID=your_login_customer_id

# ----- Messaging Integrations -----
# WhatsApp Business API (Meta Cloud API)
WHATSAPP_API_KEY=your_whatsapp_api_key
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token

# WATI (WhatsApp Business for India)
WATI_API_KEY=your_wati_api_key
WATI_API_URL=https://live-server-xxx.wati.io

# Gupshup (WhatsApp India alternative)
GUPSHUP_API_KEY=your_gupshup_api_key
GUPSHUP_APP_NAME=your_gupshup_app_name

# Twilio (SMS/Voice fallback)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# MSG91 (SMS India)
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SENDER_ID=VOICEF
MSG91_DLT_ENTITY_ID=your_dlt_entity_id

# ----- Indian Telephony Providers -----
# TeleCMI (primary for India, cost-effective)
TELECMI_API_KEY=your_telecmi_api_key
TELECMI_API_SECRET=your_telecmi_secret
TELECMI_ACCOUNT_ID=your_telecmi_account_id

# Exotel (Indian IVR)
EXOTEL_API_KEY=your_exotel_api_key
EXOTEL_API_TOKEN=your_exotel_api_token
EXOTEL_SID=your_exotel_sid
EXOTEL_SUBDOMAIN=your_exotel_subdomain

# ----- Payments (India) -----
# Razorpay (amounts in paisa: 49999 = INR 499.99)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ----- Voice Synthesis (TTS) -----
# ElevenLabs (high quality)
ELEVENLABS_API_KEY=your_elevenlabs_api_key
# Deepgram (fast STT)
DEEPGRAM_API_KEY=your_deepgram_api_key

# ----- Workflow Automation -----
# n8n
N8N_API_URL=http://localhost:5678/api/v1
N8N_API_KEY=your_n8n_api_key
N8N_WEBHOOK_URL=http://localhost:5678

# Flowise
FLOWISE_API_URL=http://localhost:3000/api/v1
FLOWISE_API_KEY=your_flowise_api_key

# ----- Notifications -----
# Slack
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SALES_CHANNEL=#sales-leads
SLACK_CS_CHANNEL=#customer-success
SLACK_ALERTS_CHANNEL=#voice-ai-alerts

# Email (SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key
FROM_EMAIL=notifications@voiceflow.ai

# Mailgun (alternative)
MAILGUN_API_KEY=your_mailgun_api_key
MAILGUN_DOMAIN=mg.voiceflow.ai

# ----- Cloud Storage -----
# AWS S3 (ap-south-1 for India)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1
S3_BUCKET_NAME=voiceflow-audio
S3_BUCKET_URL=https://voiceflow-audio.s3.ap-south-1.amazonaws.com

# ----- Monitoring -----
# Sentry (error tracking)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project

# Prometheus
PROMETHEUS_ENABLED=True
PROMETHEUS_PORT=9090

# OpenTelemetry
OTEL_ENABLED=False
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ----- Security -----
# API Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,https://app.voiceflow.ai

# ----- Feature Flags -----
ENABLE_EMOTION_DETECTION=True
ENABLE_DIALECT_DETECTION=True
ENABLE_GEN_Z_SLANG=True
ENABLE_MARKETING_AUTOMATION=True
ENABLE_CRM_SYNC=True
ENABLE_WHATSAPP_INTEGRATION=True
ENABLE_ANALYTICS=True

# ----- White-Label -----
PLATFORM_NAME=VoiceFlow Marketing AI
PLATFORM_DOMAIN=voiceflow.io
ENABLE_WHITE_LABEL=True
DEFAULT_COMMISSION_RATE=20

# ----- Frontend -----
VITE_API_URL=http://localhost:8000
