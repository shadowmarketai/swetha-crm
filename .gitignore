# ----- Data, Models, Logs -----
# `models/` matches both the root-level ML artifact dir and runtime 3D
# assets in `frontend/public/models/` (GLB files dropped in locally — see
# the README there). The SQLAlchemy ORM package at `src/api/models/` must
# stay tracked, so we whitelist it explicitly below.
data/
models/
logs/
!src/api/models/
!src/api/models/**
*.wav
*.mp3
*.ogg
*.m4a
*.flac

# ----- Database -----
*.db
*.sqlite3

# ----- Docker -----
.docker/

# ----- Jupyter -----
.ipynb_checkpoints/

