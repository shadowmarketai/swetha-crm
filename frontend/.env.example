# VoiceFlow Frontend Environment Variables
# Copy this file to .env.local and update the values

# API URL - Your FastAPI backend
VITE_API_URL=http://localhost:8000

# WebSocket URL - For live call updates
VITE_WS_URL=ws://localhost:8000/ws

# App Info
VITE_APP_NAME=VoiceFlow Marketing AI
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_WHITELABEL=true
